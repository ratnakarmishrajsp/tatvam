AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js

# TATVAM - Optimized LiteSpeed Server Configuration
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Automatic HTTPS Redirect
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Pretty URL routing
    RewriteRule ^ai-digital-product/?$ ai-digital-product.html [L,QSA]
    RewriteRule ^ai-product/?$ ai-digital-product.html [L,QSA]
    RewriteRule ^positive-thinking/?$ positive-thinking.html [L,QSA]
    RewriteRule ^sanskar30/?$ sanskar30.php [L,QSA]
    RewriteRule ^sanskar-30/?$ sanskar30.php [L,QSA]
    
    # Fallback extensionless HTML routing
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L,QSA]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|css|js|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
